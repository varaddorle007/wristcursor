<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black"
    android:id="@+id/root_view">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/content_start_padding"
        android:paddingBottom="@dimen/content_end_padding"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Dialog.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:text="@string/pref_help"/>

        <TextView
            style="@style/Text.Dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:text="@string/help_connect_steps"/>

    </LinearLayout>
</ScrollView>
