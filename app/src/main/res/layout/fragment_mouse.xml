<?xml version="1.0" encoding="utf-8"?>
<!--
  Galaxy Watch 6 Classic 47mm (SM-R965F): 480x480 px @ 340dpi == 225.9dp, ROUND.
  Visible area is the inscribed circle: radius 113dp about (113,113). For every element,
  (distance of its centre from the screen centre) + (its own radius) must stay under ~108dp.
  Nothing is anchored to a parent corner, because the corners are not on screen.

  Vertical budget is assigned with explicit top margins so the rows can never collide:
    brand    22..36     hero  46..134     status 138..160     buttons 166..210
  The two 44dp controls land at (113 +/- 28, 188) -> 78dp from centre, +22dp radius = 100dp.
  They remain inside the 113dp visible circle on the Watch 6, including the 40mm model.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mouse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/mouse_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/mouse_glow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_wow_glow_paused"
            app:layout_constraintBottom_toBottomOf="@id/mouse_icon"
            app:layout_constraintEnd_toEndOf="@id/mouse_icon"
            app:layout_constraintStart_toStartOf="@id/mouse_icon"
            app:layout_constraintTop_toTopOf="@id/mouse_icon" />

        <ImageView
            android:id="@+id/mouse_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="46dp"
            android:clickable="true"
            android:contentDescription="@string/mouse_toggle_cd"
            android:focusable="true"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wow_mouse"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.39" />

        <TextView
            android:id="@+id/mouse_status"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginTop="138dp"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/mouse_status_paused"
            android:textAllCaps="true"
            android:textColor="@color/wow_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.74" />

        <TextView
            android:id="@+id/btn_help"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="166dp"
            android:background="@drawable/bg_circle_soft"
            android:contentDescription="@string/mouse_help"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.375"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="166dp"
            android:background="@drawable/bg_circle_soft"
            android:contentDescription="@string/pref_inputSettings"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_wow_gear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.625"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/mouse_hint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0B0F14"
        android:visibility="gone">

        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="34dp"
            android:paddingEnd="34dp"
            android:text="@string/tap_to_click" />
    </FrameLayout>
</FrameLayout>
